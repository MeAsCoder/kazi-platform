# PostgreSQL (Neon) — pooled for runtime, unpooled for migrations/seed
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/kazi?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/kazi?sslmode=require"

# Auth.js — generate with: npx auth secret   (or openssl rand -base64 33)
AUTH_SECRET="change-me"

# The FastAPI model service (Render/Railway URL in prod, localhost in dev)
MODEL_SERVICE_URL="http://localhost:8000"
